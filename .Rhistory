# Install if necessary
# install.packages("microbenchmark")
library(microbenchmark)
# Exact cumulative probability
exact_binom <- function(x, n, p) {
pbinom(x, size = n, prob = p)
}
# Normal approximation to cumulative probability
normal_approx <- function(x, n, p) {
mu <- n * p
sigma <- sqrt(n * p * (1 - p))
pnorm(x + 0.5, mean = mu, sd = sigma)
}
# Example parameters
n <- 1000
p <- 0.4
x <- 420
# Verify results are close
exact_result <- exact_binom(x, n, p)
approx_result <- normal_approx(x, n, p)
cat("Exact:", exact_result, "\n")
cat("Approximation:", approx_result, "\n")
cat("Difference:", abs(exact_result - approx_result), "\n\n")
# Benchmark
results <- microbenchmark(
Exact = exact_binom(x, n, p),
Normal = normal_approx(x, n, p),
times = 100000
)
print(results)
# Summary statistics
print(summary(results))
# Plot
boxplot(results, main = "Benchmark: Exact Binomial vs Normal Approximation")
