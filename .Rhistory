X <-function(n=1){
bl <- sample(c(1,7),
n,
replace=TRUE
)
print(bl)
}
# one draw
X()
# many draws
X(100)
# function for two X counters, 1 and 7, without printing
X <-function(n=1){
bl <- sample(c(1,7),
n,
replace=TRUE
)
}
